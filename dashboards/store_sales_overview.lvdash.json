{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Headline metrics",
      "queryLines": [
        "SELECT MEASURE(`Net Sales`) AS net_sales, MEASURE(`Ticket Count`) AS tickets, MEASURE(`Average Ticket Value`) AS avg_ticket FROM workspace.gold.store_sales_metrics"
      ]
    },
    {
      "name": "by_category",
      "displayName": "Net sales by category",
      "queryLines": [
        "SELECT `Category` AS category, MEASURE(`Net Sales`) AS net_sales FROM workspace.gold.store_sales_metrics GROUP BY `Category`"
      ]
    },
    {
      "name": "by_store_state",
      "displayName": "Net sales by store state",
      "queryLines": [
        "SELECT `Store State` AS store_state, MEASURE(`Net Sales`) AS net_sales FROM workspace.gold.store_sales_metrics GROUP BY `Store State`"
      ]
    },
    {
      "name": "by_date",
      "displayName": "Net sales by day",
      "queryLines": [
        "SELECT `Sold Date` AS sold_date, MEASURE(`Net Sales`) AS net_sales FROM workspace.gold.store_sales_metrics GROUP BY `Sold Date`"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Store Sales Overview",
      "layout": [
        {
          "widget": {
            "name": "c_sales",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpis",
                  "fields": [
                    {
                      "name": "sum(net_sales)",
                      "expression": "SUM(`net_sales`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(net_sales)",
                  "displayName": "Net Sales"
                }
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 2,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "c_tickets",
