{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Headline metrics",
      "queryLines": [
        "SELECT MEASURE(`Total Revenue`) AS total_revenue, MEASURE(`Transaction Count`) AS transactions, MEASURE(`Average Transaction Value`) AS avg_txn FROM workspace.gold.sales_metrics"
      ]
    },
    {
      "name": "by_product",
      "displayName": "Revenue by product",
      "queryLines": [
        "SELECT `Product` AS product, MEASURE(`Total Revenue`) AS revenue FROM workspace.gold.sales_metrics GROUP BY `Product`"
      ]
    },
    {
      "name": "by_country",
      "displayName": "Revenue by franchise country",
      "queryLines": [
        "SELECT `Franchise Country` AS country, MEASURE(`Total Revenue`) AS revenue FROM workspace.gold.sales_metrics GROUP BY `Franchise Country`"
      ]
    },
    {
      "name": "by_day",
      "displayName": "Revenue by day",
      "queryLines": [
        "SELECT `Sold Date` AS sold_date, MEASURE(`Total Revenue`) AS revenue FROM workspace.gold.sales_metrics GROUP BY `Sold Date`"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Bakery Sales Overview",
      "layout": [
        {
          "widget": {
            "name": "c_rev",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpis",
                  "fields": [
                    {
                      "name": "sum(total_revenue)",
                      "expression": "SUM(`total_revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(total_revenue)",
                  "displayName": "Total Revenue"
                }
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 2,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "c_txn",
            "queries": [
              {
                "name": "main_query",
